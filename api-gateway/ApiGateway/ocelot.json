{
    "Routes": [
        {
            "DownstreamPathTemplate": "/orchestrator/flight/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                { "Host": "localhost", "Port": 3002 }
            ],
            "UpstreamPathTemplate": "/api/flight/{everything}",
            "UpstreamHttpMethod": [ "GET" ]
        },
        {
            "DownstreamPathTemplate": "/notams/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                { "Host": "localhost", "Port": 3000 }
            ],
            "UpstreamPathTemplate": "/api/notams/{everything}",
            "UpstreamHttpMethod": [ "GET", "POST" ]
        },
        {
            "DownstreamPathTemplate": "/weather",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                { "Host": "localhost", "Port": 8001 }
            ],
            "UpstreamPathTemplate": "/api/weather",
            "UpstreamHttpMethod": [ "GET" ]
        },
        {
            "DownstreamPathTemplate": "/flights/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                { "Host": "localhost", "Port": 8010 }
            ],
            "UpstreamPathTemplate": "/api/flights/{everything}",
            "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
        },
        {
            "DownstreamPathTemplate": "/flights",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                { "Host": "localhost", "Port": 8010 }
            ],
            "UpstreamPathTemplate": "/api/flights/",
            "UpstreamHttpMethod": [ "GET", "POST" ] 
        }
    ],
    "GlobalConfiguration": {
        "BaseUrl": "http://localhost:7000"
    }
}